# PUBLIC DEMO - safe default; do not commit your real .env
PUBLIC_DEMO_ONLY=true
# Set only for a private administrative deployment. Generate a strong random value.
APP_ADMIN_KEY=

# To allow live log reads in a PRIVATE instance, set PUBLIC_DEMO_ONLY=false,
# add a strong APP_ADMIN_KEY, and provide read-only SDK credentials as env secrets.
AZURE_WORKSPACE_ID=
AZURE_LOG_TABLE=AppTraces
# Option A: managed identity / workload identity. Option B: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET

AWS_REGION=us-east-1
AWS_LOG_GROUP=
# Use IAM role or short-lived AWS credentials. Do NOT store credentials in source code.

GCP_PROJECT_ID=
# Prefer workload identity. GOOGLE_APPLICATION_CREDENTIALS may point to a private mounted file locally.

# Optional paid model calls for admin-only questions. Disabled by default.
ENABLE_LLM=false
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Optional: RCA database. Local SQLite files on Render Free vanish on restart/spindown.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# AI_RCA_ON_RUN=false (explicitly opt in to model calls on each run)
# In the protected UI, you can input write-only cloud credentials and the API key temporarily.
# Azure: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
# AWS: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, optional AWS_SESSION_TOKEN
# GCP: GCP_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS
